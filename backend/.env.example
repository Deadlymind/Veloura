DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
# Optional: defaults to local SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/veloura
STORE_CURRENCY=USD
STORE_LOCALE=en-US
# Leave unset until you have real contact/social destinations.
STORE_CONTACT_EMAIL=
STORE_INSTAGRAM_URL=
STORE_TIKTOK_URL=
# Leave empty for the wordmark; optional supplied logo: /images/veloura-logo.jpeg
STORE_LOGO_URL=
